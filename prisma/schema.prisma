generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum Role {
  CUSTOMER
  STAFF
  ADMIN
}
enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  CANCELLED
  DEMO
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role Role @default(CUSTOMER)
  createdAt DateTime @default(now())
  sessions Session[]
  addresses Address[]
  orders Order[]
  favorites Favorite[]
  cart CartItem[]
  resets PasswordReset[]
}
model Session {
  id String @id
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
  @@index([userId])
  @@index([expiresAt])
}
model PasswordReset {
  id String @id
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}
model Address {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  name String
  line1 String
  city String
  postalCode String
  country String
}
model Category {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  products Product[]
}
model Collection {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  products Product[]
}
model Product {
  id String @id @default(cuid())
  slug String @unique
  name String
  description String
  material String
  price Int
  active Boolean @default(true)
  featured Boolean @default(false)
  categoryId String
  category Category @relation(fields:[categoryId],references:[id])
  collectionId String
  collection Collection @relation(fields:[collectionId],references:[id])
  images ProductImage[]
  variants Variant[]
  favorites Favorite[]
  createdAt DateTime @default(now())
  @@index([categoryId,active])
  @@index([collectionId])
}
model ProductImage {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  url String
  alt String
  position Int @default(0)
}
model Variant {
  id String @id @default(cuid())
  sku String @unique
  productId String
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  size String
  color String
  stock Int @default(0)
  active Boolean @default(true)
  movements InventoryMovement[]
  cart CartItem[]
  lines OrderLine[]
  @@unique([productId,size,color])
}
model InventoryMovement {
  id String @id @default(cuid())
  variantId String
  variant Variant @relation(fields:[variantId],references:[id])
  delta Int
  reason String
  createdAt DateTime @default(now())
}
model Favorite {
  userId String
  productId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  @@id([userId,productId])
}
model CartItem {
  userId String
  variantId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  variant Variant @relation(fields:[variantId],references:[id],onDelete:Cascade)
  quantity Int
  @@id([userId,variantId])
}
model Order {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id])
  idempotencyKey String @unique
  status OrderStatus @default(PENDING)
  subtotal Int
  discount Int @default(0)
  tax Int
  shipping Int
  total Int
  address Json
  createdAt DateTime @default(now())
  expiresAt DateTime
  lines OrderLine[]
  payment Payment?
  couponId String?
  coupon Coupon? @relation(fields:[couponId],references:[id])
  @@index([userId,createdAt])
  @@index([status,expiresAt])
}
model OrderLine {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id])
  variantId String
  variant Variant @relation(fields:[variantId],references:[id])
  name String
  size String
  color String
  price Int
  quantity Int
}
model Payment {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields:[orderId],references:[id])
  stripeSessionId String? @unique
  status String @default("UNPAID")
}
model WebhookEvent {
  id String @id
  type String
  createdAt DateTime @default(now())
}
model Coupon {
  id String @id @default(cuid())
  code String @unique
  percent Int
  active Boolean @default(true)
  expiresAt DateTime?
  orders Order[]
}
model Setting {
  id String @id @default("store")
  taxBps Int @default(2100)
  shipping Int @default(900)
  freeShippingAt Int @default(25000)
}
model Audit {
  id String @id @default(cuid())
  actorId String
  action String
  entityId String
  detail Json
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model RateLimit {
  key String @id
  count Int
  resetAt DateTime
  @@index([resetAt])
}
