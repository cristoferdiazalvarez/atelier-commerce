{
  "name": "atelier-commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "db:local": "node scripts/local-db.mjs",
    "reconcile": "node --env-file-if-exists=.env --import tsx scripts/reconcile.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "local": "node scripts/local.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "security:scan": "node scripts/check-secrets.mjs",
    "verify:hosted": "node scripts/verify-hosted.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "lucide-react": "^0.548.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0",
    "stripe": "^19.0.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.10.1",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": "22.x"
  }
}
