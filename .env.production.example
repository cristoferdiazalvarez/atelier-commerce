# Copy values into private production environment settings; never commit actual credentials.
DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/atelier?sslmode=require&connection_limit=2&pool_timeout=20
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/atelier?sslmode=require
APP_URL=https://YOUR-ATELIER-DOMAIN.vercel.app
DEMO_CHECKOUT=true
DEMO_LOGIN=true
ALLOW_ADMIN_WRITES=false
# Optional, private admin provisioning only. Never configure a public/shared administrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Leave blank for the initial unpaid public demo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set privately to a cryptographically random value with at least 32 characters.
CRON_SECRET=
